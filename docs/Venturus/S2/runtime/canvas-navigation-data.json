      "url": "manage-infrastructure",
      "subHeader": {
        "htmlContent": "<h2 class=\"sub-header__subtitle\">Manage Infrastructure</h2><div class=\"sub-header__controls\"><div id=\"siteSelect\" class=\"sub-header__site-select\"></div><div class=\"sub-header__divider\" id=\"subheaderScopeDivider\" style=\"display: none;\"></div><div id=\"projectSelect\" class=\"sub-header__project-select\" style=\"display: none;\"></div><div class=\"tree-search-wrapper sub-header__tree-search\" id=\"subheaderSearchWrapper\" style=\"display: none;\"><input type=\"text\" id=\"treeSearch\" class=\"form-input search-input-with-icon\" placeholder=\"Search by hostname, ID, faculty ...\" autocomplete=\"off\" disabled><span class=\"search-input-icon\"><sf-symbol name=\"magnifyingglass\" style=\"font-size:16px\"></sf-symbol></span><div class=\"tree-search__results\" id=\"searchResults\"></div></div><div class=\"sub-header__actions\" id=\"subheaderActions\" style=\"display: none;\"><button class=\"btn btn--secondary btn--small\" id=\"exportBtn\"><sf-symbol name=\"square.and.arrow.up\" style=\"font-size:14px; vertical-align: -0.15em; margin-right: 0.4rem\"></sf-symbol>Export</button><button class=\"btn btn--primary btn--small\" id=\"newServerBtn\"><sf-symbol name=\"plus.circle\" style=\"font-size:14px; color:var(--color-fill); vertical-align: -0.15em; margin-right: 0.4rem\"></sf-symbol>Create Node</button></div></div>"
      },
