    {
      "label": "Device Recovery",
      "url": "device-recovery",
      "subHeader": {
        "htmlContent": "<h2 class=\"sub-header__subtitle\">Device Recovery</h2><div class=\"sub-header__controls\"><div class=\"fdr-subtabs\"><div class=\"tabs\" role=\"tablist\"><button type=\"button\" class=\"tabs__tab tabs__tab--active\" role=\"tab\" data-fdr-tab=\"registration\">Registration</button><button type=\"button\" class=\"tabs__tab\" role=\"tab\" data-fdr-tab=\"deploy\">Roll out</button></div></div><div class=\"proj-multi-select\" id=\"fdrSites\"></div><div class=\"proj-multi-select\" id=\"fdrProjects\"></div><div class=\"form-group\" id=\"searchGroup\" style=\"margin-bottom:0\"><input type=\"text\" id=\"fdrSearch\" class=\"form-input\" placeholder=\"Search devices, campuses or faculties\" autocomplete=\"off\" aria-label=\"Search devices\" style=\"width:280px\"></div><label class=\"switch\"><input type=\"checkbox\" class=\"switch__input\" id=\"fdrGroup\" checked><span class=\"switch__slider\"></span><span class=\"switch__label\">Group by campus</span></label><div class=\"mu-filter-status\" id=\"fdrFilterStatus\" style=\"display:none;align-items:center;gap:var(--space-xs)\"><span class=\"mu-filter-status__label\" style=\"color:var(--color-glyph-gray-secondary);font-size:var(--font-size-xxs)\">Results are filtered</span><button id=\"fdrClearFilters\" class=\"btn btn--link btn--small\"><sf-symbol name=\"xmark\"></sf-symbol> Clear Filters</button></div><div class=\"sub-header__actions\" id=\"fdrSelectionBar\"><button type=\"button\" class=\"btn btn--primary btn--small\" id=\"fdrSendBtn\" disabled><sf-symbol name=\"arrow.triangle.2.circlepath\"></sf-symbol> <span id=\"fdrSendLabel\">Send Recovery Request</span></button></div></div>"
