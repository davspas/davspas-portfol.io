    {
      "label": "Devices",
      "url": "manage-devices",
      "subHeader": {
        "htmlContent": "<h2 class=\"sub-header__subtitle\">Manage Devices</h2><div class=\"sub-header__controls\"><div id=\"unitsCascader\" class=\"proj-cascader\"></div><div class=\"form-group\" id=\"searchGroup\" style=\"margin-bottom:0;display:none\"><input type=\"text\" id=\"searchInput\" class=\"form-input\" placeholder=\"Search Devices by Asset Tag\" style=\"width:280px\"></div><div class=\"mu-filter-status\" id=\"filterStatus\" style=\"display:none;align-items:center;gap:var(--space-xs)\"><span class=\"mu-filter-status__label\" style=\"color:var(--color-glyph-gray-secondary);font-size:var(--font-size-xxs)\">Results are filtered</span><button id=\"clearFiltersBtn\" class=\"btn btn--link btn--small\"><sf-symbol name=\"xmark\"></sf-symbol> Clear Filters</button></div><div class=\"sub-header__actions\"><div class=\"dropdown-wrapper\"><button id=\"exportBtn\" class=\"btn btn--secondary btn--small\"><sf-symbol name=\"square.and.arrow.up\"></sf-symbol> Export <sf-symbol name=\"chevron.down\"></sf-symbol></button><div id=\"exportDropdown\" class=\"dropdown-menu\" style=\"display:none\"><button class=\"dropdown-menu__item\" data-export=\"template\">Template</button><button class=\"dropdown-menu__item\" id=\"exportDataBtn\" data-export=\"data\" disabled>Data</button></div></div><div class=\"button-group\" id=\"approveRejectGroup\" style=\"display:none\"><button id=\"approveBtn\" class=\"btn btn--secondary btn--small\" disabled><sf-symbol name=\"hand.thumbsup\"></sf-symbol> Approve</button><button id=\"rejectBtn\" class=\"btn btn--secondary btn--small\" disabled><sf-symbol name=\"hand.thumbsdown\"></sf-symbol> Reject</button></div><button id=\"revokeBtn\" class=\"btn btn--danger btn--small\" style=\"display:none\" disabled><sf-symbol name=\"minus.circle\"></sf-symbol> Retire</button><button id=\"addBtn\" class=\"btn btn--primary btn--small\"><sf-symbol name=\"plus.circle\"></sf-symbol> Add</button></div></div>"
      },
